{
  "name": "whistle.sse-mock-plus",
  "version": "1.0.1",
  "description": "Whistle plugin that mocks requests as SSE streams: JSON messages with delays, line-by-line file replay (.jsonl), event/id/data fields, loop mode and a web UI.",
  "main": "index.js",
  "scripts": {
    "test": "node test/sse.test.js"
  },
  "files": [
    "index.js",
    "lib/",
    "public/",
    "data/",
    "README.md"
  ],
  "keywords": [
    "whistle",
    "whistle-plugin",
    "plugin",
    "sse",
    "server-sent-events",
    "mock",
    "stream"
  ],
  "author": "ducaoya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ducaoya/whistle-sse-mock-plus-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/ducaoya/whistle-sse-mock-plus-plugin/issues"
  },
  "homepage": "https://github.com/ducaoya/whistle-sse-mock-plus-plugin#readme",
  "engines": {
    "node": ">=12.0.0"
  },
  "whistleConfig": {
    "priority": 0,
    "hintList": [
      "sse-mock://",
      "sse-mock://default",
      "sse-mock://{configName}",
      "sse-mock://file:./data/example.txt,1000"
    ]
  }
}
